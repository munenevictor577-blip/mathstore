### 3.4 Python Library Usage

MathStore can be imported directly into Python scripts, backend services, or Jupyter notebooks.

```python
# 1. Calculus & Step-by-Step Derivation
from mathstore.calculus import CalculusAnalyzer

calc = CalculusAnalyzer()
deriv = calc.differentiate("2^x sin x", variable="x", order=1)
steps = calc.differentiate_steps("x**2 * sin(x)", variable="x")
for step in steps:
    print(step)

# 2. Equation Solving
from mathstore.algebra import EquationSolver

solver = EquationSolver()
roots = solver.solve_linear("x**2 - 5*x + 6 = 0", variable="x")
print("Roots:", roots)  # [2, 3]

# 3. Matrix Analysis
from mathstore.core import MatrixAnalyzer

mat_engine = MatrixAnalyzer()
det = mat_engine.determinant("1, 2; 3, 4")
rref_str = mat_engine.rref("1, 2, -1; 2, 4, 3")
eigenvalues = mat_engine.eigenvalues("2, 0; 0, 3")

# 4. Probability & Statistics
from mathstore.statistics import StatsAnalyzer

stats = StatsAnalyzer()
data = [10.2, 11.5, 12.1, 9.8, 10.9, 11.2]
summary = stats.summary(data)
ci_lower, ci_upper, margin = stats.confidence_interval(data, confidence=0.95)
ttest = stats.one_sample_t_test(data, pop_mean=10.0, alternative="two-sided")

# 5. Practice & Active-Recall Verification
from mathstore.study import generate_question, check_answer

q = generate_question(topic="derivatives", difficulty="medium", seed=101)
is_correct, feedback = check_answer("2*cos(2*x)", q)
print(f"Correct: {is_correct} | Feedback: {feedback}")
```

